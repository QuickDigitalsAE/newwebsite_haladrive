RewriteEngine On

# Single car page: /cars/slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cars/([^/]+)/?$ car.php?slug=$1 [L,QSA]

# Brands page: /brands/slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^brands/([^/]+)/?$ brands.php?slug=$1 [L,QSA]

# lease page: /lease/slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^lease/([^/]+)/?$ lease.php?slug=$1 [L,QSA]

# Main car page: /car
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^car/?$ car.php [L,QSA]

# General rule for all other PHP files: /pagename
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L,QSA]