RewriteEngine On
RewriteBase /new.haladrive.ae

# Single car page: /cars/slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cars/([^/]+)/?$ car.php?slug=$1 [L,QSA]
RewriteRule ^brands/([^/]+)/?$ brands.php?slug=$1 [L,QSA]

# Main page: /car
RewriteRule ^car/?$ car.php [L,QSA]
