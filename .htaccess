RewriteEngine On
RewriteBase /haladrive/

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cars/([^/]+)/?$ src/cars.php?slug=$1 [L,QSA]
