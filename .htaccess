DirectoryIndex index.php
Options -MultiViews

RewriteEngine On
RewriteBase /newwebsite_haladrive/

# Remove /index URL
RewriteRule ^index/?$ /newwebsite_haladrive/ [R=301,L,QSD]
RewriteRule ^index\.php/?$ /newwebsite_haladrive/ [R=301,L,QSD]

# ----------------- ARABIC HOME -----------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/?$ index.php?lang=ar [L,QSA]

# AR cars single
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/cars/([^/]+)/?$ cars.php?slug=$1&lang=ar [L,QSA]

# AR cars main
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/cars/?$ cars.php?lang=ar [L,QSA]

# AR faq main
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/faq/?$ faq.php?lang=ar [L,QSA]

# AR blogs single
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/blogs/([^/]+)/?$ blogs.php?slug=$1&lang=ar [L,QSA]

# AR lease single
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/lease/([^/]+)/?$ lease.php?slug=$1&lang=ar [L,QSA]

# AR blogs main
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/blogs/?$ blogs.php?lang=ar [L,QSA]

# AR locations main
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/locations/?$ locations.php?lang=ar [L,QSA]

# AR about main
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/about-us/?$ about-us.php?lang=ar [L,QSA]

# AR contact main
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/contact/?$ contact.php?lang=ar [L,QSA]

# AR contact main
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/privacy-policy/?$ privacy-policy.php?lang=ar [L,QSA]

# AR brand page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/brands/([^/]+)/?$ brands.php?slug=$1&lang=ar [L,QSA]

# AR brand page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/carsbrands/([^/]+)/?$ brands.php?slug=$1&lang=ar [L,QSA]

# AR Location page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ar/([^/]+)/?$ location.php?slug=$1&lang=ar [L,QSA]

